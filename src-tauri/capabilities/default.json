{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:write-all",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "whatsapp://*" },
        { "url": "https://*" }
      ]
    }
  ]
}